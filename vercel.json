{
  "installCommand": "npm install",
  "buildCommand": "npm run build:control-plane-cloud",
  "outputDirectory": "apps/web/dist/control-plane",
  "functions": {
    "api/index.ts": {
      "maxDuration": 10,
      "includeFiles": [
        "deploy/appliance/**",
        "dist/appliance/**",
        "docs/integrations/tms-http-v1.openapi.yaml",
        "docs/integrations/tms-http-v1.md"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
