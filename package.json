{
  "name": "quote_ops_v1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:ts && npm --workspace @quoteops/web run build",
    "build:control-plane-cloud": "npm run build:ts && npm --workspace @quoteops/web run build:control",
    "build:ts": "tsc -b --force packages/shared packages/contracts packages/quote-core packages/audit packages/criteria packages/connectors packages/knowledge apps/agent apps/api apps/control-plane apps/control-plane-api",
    "dev:api": "tsx apps/api/src/server.ts",
    "dev:agent": "tsx apps/agent/src/dev.ts",
    "dev:control-plane-api": "tsx apps/control-plane-api/src/server.ts",
    "dev:web": "npm --workspace @quoteops/web run dev",
    "demo:nmx-control-plane": "bash deploy/control-plane/demo-nmx.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run build:ts"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@supabase/supabase-js": "^2.110.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}