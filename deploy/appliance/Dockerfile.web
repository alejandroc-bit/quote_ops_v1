# syntax=docker/dockerfile:1

# build on the runner's native arch: vite/esbuild hangs under QEMU arm64
# emulation, and the static output is arch-independent anyway
FROM --platform=$BUILDPLATFORM node:22-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN npm ci

COPY apps/web apps/web
COPY packages/contracts packages/contracts
COPY tsconfig.base.json tsconfig.base.json
RUN npm --workspace @quoteops/web run build:client

FROM nginx:1.27-alpine AS runtime
COPY deploy/appliance/nginx-web.conf /etc/nginx/conf.d/default.conf
# vite emits to dist/client-portal (see apps/web build:client); copying dist/
# itself leaves nginx's stock index.html in place and the appliance serves
# the "Welcome to nginx!" page instead of the client portal.
COPY --from=builder /app/apps/web/dist/client-portal /usr/share/nginx/html
EXPOSE 3000
